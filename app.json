{
  "expo": {
    "name": "DBus",
    "slug": "dbus-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "dbus-app",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tovicdev.dbus",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "CFBundleDisplayName": "DBus",
        "CFBundleLocalizations": [
          "es",
          "eu",
          "en"
        ],
        "CFBundleDevelopmentRegion": "es"
      }
    },
    "android": {
      "package": "com.tovicdev.dbus"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DBus usa tu ubicación para mostrarte las paradas cercanas y sus próximas salidas."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "icon": "./assets/icon.png"
  }
}
